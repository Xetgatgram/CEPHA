# =============================================================================
# Zentrale Zugangsdaten fuer OpenObserve (lokal, docker-compose.localnodes.yml)
# =============================================================================
# Kopieren nach ".env" im selben Ordner (deploy/compose/) und Passwort anpassen.
# ".env" wird von .gitignore ausgeschlossen - niemals committen.
#
# WICHTIG: OpenObserve v0.91+ erzwingt eine Mindest-Passwortstaerke fuer den
# Root-User. Ein zu schwaches Passwort (z.B. "admin") fuehrt dazu, dass
# OpenObserve beim Start fehlschlaegt bzw. der Root-User nicht angelegt wird -
# nachfolgende otel-collector-Requests schlagen dann mit HTTP 401 fehl.
# Empfehlung: mindestens 8 Zeichen, Gross-/Kleinbuchstaben + Ziffer.

OPENOBSERVE_USER=admin@admin.local
OPENOBSERVE_PASSWORD=CHANGEME_min8Zeichen
